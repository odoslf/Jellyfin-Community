<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4"><PrivateAssets>all</PrivateAssets></PackageReference>

    <!-- Test-only runtime copies. The production plugin deliberately excludes
         Jellyfin host assemblies and SQLite runtime assets from its package. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Common" Version="12.4.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Data" Version="12.4.0" PrivateAssets="all" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.4.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.Community/Jellyfin.Plugin.Community.csproj" />
  </ItemGroup>
</Project>
